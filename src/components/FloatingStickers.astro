---
import MicroSticker from './svg/MicroSticker.astro';
---

<div class="relative w-full max-w-4xl mx-auto h-28 my-4 pointer-events-none select-none">
  <!-- Interactive-feeling scattered stickers with CSS floating keyframes -->
  <div class="absolute left-[10%] top-4 animate-[bounce_3.2s_infinite]">
    <MicroSticker type="flower" class="w-8 h-8 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[24%] top-12 animate-[bounce_2.8s_infinite_0.3s]">
    <MicroSticker type="cross" class="w-6 h-6 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[38%] top-2 animate-[bounce_3.5s_infinite_0.6s]">
    <MicroSticker type="thumbs-up" class="w-7 h-7 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[54%] top-14 animate-[bounce_3.1s_infinite_0.2s]">
    <MicroSticker type="coin" class="w-7 h-7 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[70%] top-3 animate-[bounce_2.6s_infinite_0.5s]">
    <MicroSticker type="flower" class="w-8 h-8 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[84%] top-10 animate-[bounce_3.4s_infinite_0.8s]">
    <MicroSticker type="cross" class="w-6 h-6 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>

  <div class="absolute left-[92%] top-2 animate-[bounce_2.9s_infinite_0.4s]">
    <MicroSticker type="sparkle" class="w-6 h-6 filter drop-shadow-[2px_2px_0px_#111113]" />
  </div>
</div>

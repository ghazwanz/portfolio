---
interface Props {
  type?: "pine" | "round";
  class?: string;
}
const { type = "pine", class: className = "w-16 h-24" } = Astro.props;
---

{type === "pine" ? (
  <svg class={className} viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <!-- Trunk -->
    <rect x="10" y="24" width="4" height="6" fill="#A16207" />
    <rect x="9" y="24" width="1" height="6" fill="#111113" />
    <rect x="14" y="24" width="1" height="6" fill="#111113" />
    <rect x="10" y="30" width="4" height="1" fill="#111113" />

    <!-- Foliage Layers (Tier 1 Top) -->
    <rect x="11" y="2" width="2" height="6" fill="#4ADE80" />
    <rect x="9" y="6" width="6" height="4" fill="#22C55E" />
    <!-- Outline Tier 1 -->
    <rect x="11" y="1" width="2" height="1" fill="#111113" />
    <rect x="10" y="2" width="1" height="4" fill="#111113" />
    <rect x="13" y="2" width="1" height="4" fill="#111113" />
    <rect x="8" y="6" width="1" height="4" fill="#111113" />
    <rect x="15" y="6" width="1" height="4" fill="#111113" />
    <rect x="9" y="10" width="6" height="1" fill="#111113" />

    <!-- Foliage Tier 2 Mid -->
    <rect x="8" y="11" width="8" height="6" fill="#22C55E" />
    <rect x="6" y="14" width="12" height="4" fill="#16A34A" />
    <!-- Outline Tier 2 -->
    <rect x="7" y="11" width="1" height="3" fill="#111113" />
    <rect x="16" y="11" width="1" height="3" fill="#111113" />
    <rect x="5" y="14" width="1" height="4" fill="#111113" />
    <rect x="18" y="14" width="1" height="4" fill="#111113" />
    <rect x="6" y="18" width="12" height="1" fill="#111113" />

    <!-- Foliage Tier 3 Base -->
    <rect x="5" y="19" width="14" height="5" fill="#16A34A" />
    <!-- Shadow Base -->
    <rect x="4" y="22" width="16" height="2" fill="#15803D" />
    <!-- Outline Tier 3 -->
    <rect x="4" y="19" width="1" height="3" fill="#111113" />
    <rect x="19" y="19" width="1" height="3" fill="#111113" />
    <rect x="3" y="22" width="1" height="2" fill="#111113" />
    <rect x="20" y="22" width="1" height="2" fill="#111113" />
    <rect x="4" y="24" width="16" height="1" fill="#111113" />
  </svg>
) : (
  <svg class={className} viewBox="0 0 24 32" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <!-- Trunk -->
    <rect x="10" y="22" width="4" height="8" fill="#A16207" />
    <rect x="9" y="22" width="1" height="8" fill="#111113" />
    <rect x="14" y="22" width="1" height="8" fill="#111113" />
    <rect x="10" y="30" width="4" height="1" fill="#111113" />

    <!-- Round Canopy Fill -->
    <rect x="8" y="4" width="8" height="16" fill="#4ADE80" />
    <rect x="5" y="7" width="14" height="12" fill="#22C55E" />
    <rect x="3" y="10" width="18" height="8" fill="#22C55E" />
    <rect x="5" y="18" width="14" height="4" fill="#16A34A" />

    <!-- Black Outline -->
    <rect x="8" y="3" width="8" height="1" fill="#111113" />
    <rect x="6" y="4" width="2" height="1" fill="#111113" />
    <rect x="16" y="4" width="2" height="1" fill="#111113" />
    <rect x="4" y="5" width="2" height="2" fill="#111113" />
    <rect x="18" y="5" width="2" height="2" fill="#111113" />
    <rect x="2" y="7" width="2" height="3" fill="#111113" />
    <rect x="20" y="7" width="2" height="3" fill="#111113" />
    <rect x="1" y="10" width="2" height="8" fill="#111113" />
    <rect x="21" y="10" width="2" height="8" fill="#111113" />
    <rect x="2" y="18" width="3" height="2" fill="#111113" />
    <rect x="19" y="18" width="3" height="2" fill="#111113" />
    <rect x="5" y="20" width="4" height="2" fill="#111113" />
    <rect x="15" y="20" width="4" height="2" fill="#111113" />
  </svg>
)}

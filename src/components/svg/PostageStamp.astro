---
interface Props {
  text?: string;
  subtext?: string;
  color?: string;
  class?: string;
}
const {
  text = "KAGGLE",
  subtext = "EXPERT",
  color = "#FF5722",
  class: className = "rotate-[-6deg]"
} = Astro.props;
---

<div class={`inline-block select-none filter drop-shadow-[3px_3px_0px_rgba(17,17,19,0.8)] ${className}`}>
  <!-- Perforated Stamp Container -->
  <div
    class="relative p-2.5 sm:p-3 text-center border-2 border-dashed border-[#111113]"
    style={`background-color: ${color};`}
  >
    <!-- Inner White Stamp Card -->
    <div class="bg-white px-3 py-2 border border-[#111113] flex flex-col items-center justify-center">
      <span class="font-extrabold text-xs sm:text-sm text-[#111113] tracking-wider leading-none">
        {text}
      </span>
      <span class="font-mono-custom text-[9px] text-zinc-500 tracking-widest mt-0.5 leading-none">
        {subtext}
      </span>
    </div>
  </div>
</div>

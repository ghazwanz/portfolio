---
interface Props {
  text?: string;
  class?: string;
}
const { text = "HI THERE!", class: className = "" } = Astro.props;
---

<div class={`relative inline-flex flex-col items-center select-none ${className}`}>
  {/* Stepped Pixel Pill Container */}
  <div class="relative px-3 sm:px-4 py-1.5 flex items-center justify-center">
    {/* SVG Stepped Pixel Pill Border matching Image 1 */}
    <svg
      class="absolute inset-0 w-full h-full pointer-events-none drop-shadow-[2px_2px_0px_rgba(0,0,0,0.3)]"
      viewBox="0 0 100 40"
      preserveAspectRatio="none"
      shapeRendering="crispEdges"
    >
      <path
        d="M 6,1 H 94 V 3 H 97 V 6 H 99 V 34 H 97 V 37 H 94 V 39 H 6 V 37 H 3 V 34 H 1 V 6 H 3 V 3 H 6 Z"
        fill="#FFFFFF"
        stroke="#111113"
        stroke-width="2.5"
        vector-effect="non-scaling-stroke"
      />
    </svg>

    {/* Text in Ubuntu Sans bold uppercase */}
    <span class="relative z-10 font-heading font-black text-[10px] sm:text-xs text-[#111113] tracking-wider uppercase whitespace-nowrap">
      {text}
    </span>
  </div>

  {/* Stepped Pixel Tail pointing down towards avatar */}
  <div class="relative -mt-[1px] w-3 h-2 pointer-events-none">
    <svg
      class="w-full h-full block"
      viewBox="0 0 12 8"
      fill="none"
      shapeRendering="crispEdges"
    >
      <rect x="2" y="0" width="8" height="2" fill="#FFFFFF" />
      <rect x="0" y="0" width="2" height="2" fill="#111113" />
      <rect x="10" y="0" width="2" height="2" fill="#111113" />
      <rect x="4" y="2" width="4" height="2" fill="#FFFFFF" />
      <rect x="2" y="2" width="2" height="2" fill="#111113" />
      <rect x="8" y="2" width="2" height="2" fill="#111113" />
      <rect x="5" y="4" width="2" height="2" fill="#FFFFFF" />
      <rect x="3" y="4" width="2" height="2" fill="#111113" />
      <rect x="7" y="4" width="2" height="2" fill="#111113" />
      <rect x="5" y="6" width="2" height="2" fill="#111113" />
    </svg>
  </div>
</div>

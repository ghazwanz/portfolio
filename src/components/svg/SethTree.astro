---
interface Props {
  type: "pine" | "birch";
  class?: string;
}
const { type, class: className = "w-12 h-20" } = Astro.props;
---

{type === "pine" ? (
  <svg class={className} viewBox="0 0 24 40" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <rect x="11" y="32" width="2" height="8" fill="#111113" />
    <path
      d="M12 2 L14 6 L11 6 L15 11 L12 11 L16 17 L13 17 L18 24 L14 24 L20 32 L4 32 L10 24 L6 24 L11 17 L8 17 L12 11 L9 11 L13 6 L10 6 Z"
      fill="#FFFFFF"
      stroke="#111113"
      stroke-width="1.5"
    />
    <line x1="12" y1="4" x2="12" y2="30" stroke="#111113" stroke-width="1" />
    <line x1="8" y1="14" x2="16" y2="14" stroke="#111113" stroke-width="1" />
    <line x1="7" y1="20" x2="17" y2="20" stroke="#111113" stroke-width="1" />
    <line x1="6" y1="27" x2="18" y2="27" stroke="#111113" stroke-width="1" />
    <line x1="9" y1="9" x2="11" y2="11" stroke="#111113" stroke-width="1" />
    <line x1="15" y1="9" x2="13" y2="11" stroke="#111113" stroke-width="1" />
    <line x1="8" y1="23" x2="11" y2="26" stroke="#111113" stroke-width="1" />
    <line x1="16" y1="23" x2="13" y2="26" stroke="#111113" stroke-width="1" />
  </svg>
) : (
  <svg class={className} viewBox="0 0 24 44" fill="none" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <rect x="11" y="34" width="2" height="10" fill="#111113" />
    <rect x="9" y="42" width="2" height="2" fill="#111113" />
    <rect x="13" y="42" width="2" height="2" fill="#111113" />
    <path
      d="M12 2 Q19 8 19 18 Q20 28 15 34 L9 34 Q4 28 5 18 Q5 8 12 2 Z"
      fill="#FFFFFF"
      stroke="#111113"
      stroke-width="1.8"
    />
    <path
      d="M12 32 V10 M12 28 Q16 24 17 20 M12 24 Q8 20 7 16 M12 18 Q16 14 17 11 M12 14 Q8 10 9 7"
      stroke="#111113"
      stroke-width="1.5"
      fill="none"
    />
    <circle cx="10" cy="12" r="1" fill="#111113" />
    <circle cx="15" cy="16" r="1" fill="#111113" />
    <circle cx="9" cy="22" r="1" fill="#111113" />
    <circle cx="14" cy="26" r="1" fill="#111113" />
  </svg>
)}

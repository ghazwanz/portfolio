---
import Layout from "../layouts/Layout.astro";
import HeroShader from "../components/HeroShader.astro";
import HeroStickyContainer from "../components/react/HeroStickyContainer.tsx";
import PixelAvatar from "../components/svg/PixelAvatar.astro";
import PixelSpeechBubble from "../components/svg/PixelSpeechBubble.astro";
import PixelLandscape from "../components/svg/PixelLandscape.astro";
import DraggableStickers from "../components/react/DraggableStickers.tsx";
import ProjectCardListMotion from "../components/react/ProjectCardListMotion.tsx";
import CapabilitiesSectionMotion from "../components/react/CapabilitiesSectionMotion.tsx";
import ClosingCTASection from "../components/react/ClosingCTASection.tsx";
import projects from "../data/projects.json";
---

<Layout title="Ghazwan Ababil — Front-end Developer Portfolio">
  <!-- 1. Hero Dark Canvas Section (Sticky Pinning Layer) -->
  <div class="relative w-full h-[180vh] z-0">
    <!-- WebGL GLSL Fluid Shader Canvas in Background of Hero -->
    <div class="fixed top-0 inset-0 z-0 pointer-events-none">
      <HeroShader />
    </div>

    <!-- Sticky pinned to top-0 viewport -->
    <div class="sticky top-0 w-full h-screen z-0 overflow-hidden">
      <HeroStickyContainer client:load>
        <!-- Top Header Bar -->
        <header
          class="relative z-10 flex flex-wrap items-center justify-between gap-2 text-[10px] sm:text-xs font-mono-custom uppercase text-white"
        >
          <div class="flex items-center gap-2 sm:gap-3">
            <span
              class="inline-block w-2 sm:w-2.5 h-2 sm:h-2.5 rounded-full bg-[#22C55E] animate-ping"
            ></span>
            <span class="font-bold tracking-wider"
              >AVAILABLE FOR INTERN / PROJECTS</span
            >
          </div>

          <div class="hidden md:flex items-center gap-6 text-zinc-400">
            <span>INDONESIA</span>
            <span id="live-time" class="text-white font-bold">--:-- WIB</span>
          </div>

          <div>
            <a
              href="#contact"
              class="border border-white/40 hover:border-white px-2.5 py-1 sm:px-3 sm:py-1.5 rounded transition-all hover:bg-white hover:text-black font-semibold tracking-wider text-[10px] sm:text-xs"
            >
              GET IN TOUCH
            </a>
          </div>
        </header>

        <!-- Center Display Title + Pixel Character Avatar -->
        <div
          class="relative z-10 my-auto w-full max-w-6xl mx-auto px-4 flex flex-col items-center justify-center select-none font-heading font-black text-white uppercase leading-none tracking-tight"
        >
          <!-- Single Line: GHAZWAN + [AVATAR WITH TOP PILL BUBBLE] + ABABIL -->
          <div
            class="flex items-center justify-center gap-4 sm:gap-7 md:gap-9 text-[6.2vw] sm:text-[6.8vw] md:text-[7.2vw] leading-none tracking-tight"
          >
            <span class="leading-none shrink-0">GHAZWAN</span>

            <!-- Avatar Wrapper with perfectly bound bubble chat on top -->
            <div class="relative shrink-0 flex items-center justify-center">
              <!-- Pixel Pill Speech Bubble locked directly above avatar -->
              <div
                class="absolute bottom-full mb-2 sm:mb-2.5 left-1/2 -translate-x-1/2 pointer-events-none whitespace-nowrap z-20"
              >
                <PixelSpeechBubble text="HI THERE!" />
              </div>

              <!-- Avatar Box -->
              <div
                class="shrink-0 inline-flex items-center justify-center p-2 sm:p-2.5 md:p-3 bg-[#111113] border-2 sm:border-3 border-white rounded-lg sm:rounded-xl shadow-[3px_3px_0px_#22D3EE] sm:shadow-[4px_4px_0px_#22D3EE] transition-transform hover:scale-105"
              >
                <PixelAvatar
                  class="w-10 h-10 sm:w-14 sm:h-14 md:w-16 md:h-16 lg:w-20 lg:h-20"
                />
              </div>
            </div>

            <span class="leading-none shrink-0">ABABIL</span>
          </div>
        </div>

        <!-- Bottom Meta & Down Chevron -->
        <footer
          class="relative z-10 flex items-end justify-between text-[10px] sm:text-xs font-mono-custom uppercase text-zinc-400"
        >
          <div>
            <p class="text-white font-bold">FRONT-END DEVELOPER</p>
            <p class="text-white font-bold">FRAMER WEB DESIGNER</p>
          </div>

          <div
            class="text-white text-base sm:text-lg animate-bounce select-none"
          >
            ▼
          </div>

          <div class="text-right">
            <p class="text-white font-bold">D4 TEKNIK INFORMATIKA</p>
            <p class="text-zinc-500">POLITEKNIK NEGERI MALANG</p>
          </div>
        </footer>
      </HeroStickyContainer>
    </div>
  </div>

  <!-- 2. Main Content Body (Relative z-10, Slides over the sticky hero) -->
  <div
    id="introduction"
    class="relative z-10 -mt-[80vh] rounded-t-[48px] bg-transparent shadow-[0_-16px_36px_rgba(0,0,0,0.5)]"
  >
    <!-- White Panel Wrapper for Intro + Featured Work + FiveYears -->
    <div
      class="relative z-20 bg-[#F4F4F0] rounded-t-[48px] rounded-b-[48px] sm:rounded-b-[64px] border-t-2 border-b-2 border-[#111113] shadow-[0_20px_40px_rgba(0,0,0,0.4)]"
    >
      <!-- Pixel Landscape Illustration (Awan, Gunung Parallax, Manifesto Word-Reveal) -->
      <div class="pt-8 sm:pt-12 w-full">
        <PixelLandscape />
        <!-- Meadow Playground Stickers -->
        <DraggableStickers client:load />
      </div>

      <!-- 3. Featured Work Section (Responsive Full Width Display Title + Game HUD Filter + 2-Col Masonry) -->
      <section class="w-full py-16 sm:py-24 px-4 sm:px-8 md:px-12">
        <!-- Full Width Device Edge-to-Edge Heading (fitted without horizontal overflow) -->
        <div class="w-full text-center mb-10 select-none">
          <h2
            class="text-[10.5vw] font-black text-[#111113] tracking-tight uppercase font-heading leading-none whitespace-nowrap"
          >
            FEATURED WORK
          </h2>
        </div>

        <!-- Game Theme Pixel HUD Filter Tabs & Minimal Masonry Grid -->
        <div class="max-w-6xl mx-auto">
          <ProjectCardListMotion client:load projects={projects} />
        </div>
      </section>

      <!-- 4. 5 Years in Design Section -->
      <CapabilitiesSectionMotion client:load />
    </div>

    <!-- 5. Closing CTA Section (z-0 underlapping White Panel z-20) -->
    <div id="contact" class="relative z-0 -mt-32 sm:-mt-40">
      <ClosingCTASection client:load />
    </div>
  </div>
</Layout>

<script>
  // Live Indonesian WIB (UTC+7) Digital Clock
  function updateTime() {
    const el = document.getElementById("live-time");
    if (!el) return;
    const now = new Date();
    const utc = now.getTime() + now.getTimezoneOffset() * 60000;
    const wib = new Date(utc + 3600000 * 7);
    const h = String(wib.getHours()).padStart(2, "0");
    const m = String(wib.getMinutes()).padStart(2, "0");
    const s = String(wib.getSeconds()).padStart(2, "0");
    el.textContent = `${h}:${m}:${s} WIB`;
  }
  updateTime();
  setInterval(updateTime, 1000);
</script>

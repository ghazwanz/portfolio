---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ouronii — Software & AI Engineer",
  description = "Interactive developer portfolio inspired by 90s-00s pixel aesthetics & modern brutalism."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Ubuntu Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A0A0B] text-[#111113] antialiased selection:bg-[#FF5722] selection:text-white">
    <slot />
  </body>
</html>
